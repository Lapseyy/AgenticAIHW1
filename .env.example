# Copy to .env and fill in real values. Never commit .env.

# LLM backend (OpenAI)
OPENAI_API_KEY=your-openai-key-here
MODEL_NAME=gpt-5
# NVIDIA NIM instead: use your NIM key above, uncomment the base URL, and set a NIM model name
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_NAME=<nemotron model id from build.nvidia.com>

# MCP servers
TAVILY_API_KEY=your-tavily-key-here
MCP_SERVERS_CONFIG=./mcp_config.json
WORKSPACE_DIR=./workspace

# Optional tuning
# LOG_LEVEL=INFO
# AGENT_RECURSION_LIMIT=16
# MCP_TOOL_TIMEOUT=60

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
