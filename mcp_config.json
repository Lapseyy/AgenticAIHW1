{
  "filesystem": {
    "transport": "stdio",
    "command": "mcp-server-filesystem",
    "args": ["${WORKSPACE_DIR}"]
  },
  "tavily": {
    "transport": "stdio",
    "command": "tavily-mcp",
    "args": [],
    "env": { "TAVILY_API_KEY": "${TAVILY_API_KEY}" }
  },
  "fetch": {
    "transport": "stdio",
    "command": "${PYTHON}",
    "args": ["-m", "mcp_server_fetch"]
  }
}
